{
  "name": "wdt",
  "productName": "wdt",
  "version": "0.1.3",
  "private": true,
  "main": "main.js",
  "author": {
    "name": "hu-kaiqi"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/hu-kaiqi/wdt",
  "repository": {
    "type": "git",
    "url": "https://github.com/hu-kaiqi/wdt.git"
  },
  "scripts": {
    "build-renderer": "esbuild renderer/src/main.js --bundle --format=iife --outfile=renderer/bundle.js",
    "obfuscate": "node scripts/obfuscate.js",
    "dist": "npm run build-renderer && npm run obfuscate && electron-builder --win nsis",
    "dist:linux": "npm run build-renderer && npm run obfuscate && electron-builder --linux dir",
    "start": "electron ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@milkdown/kit": "^7.12.0",
    "markdown-it": "^15.0.3",
    "turndown": "^7.2.5"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "org.wdt.editor",
    "productName": "wdt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-app/**"
    ],
    "extraMetadata": {
      "main": "dist-app/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "wdt-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "artifactName": "wdt_${version}_amd64.${ext}"
    },
    "icon": "icon.ico"
  },
  "allowScripts": {
    "electron@45.3.4": true
  }
}